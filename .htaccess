Options -Indexes
RewriteEngine On

# Canonical encrypted entry point for both the public website and the ERP.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.multitaskagency\.com$ [NC]
RewriteRule ^ https://multitaskagency.com%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self'; frame-src https://www.youtube.com https://youtube.com https://maps.google.com https://www.google.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(?:html|xml)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  SetEnvIf Request_URI "^/(?:erp|adminmt|dashboard|login)(?:/|$)" MT_PRIVATE_PAGE
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=MT_PRIVATE_PAGE
  Header always set Pragma "no-cache" env=MT_PRIVATE_PAGE
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=MT_PRIVATE_PAGE
</IfModule>

# Keep the PHP API at its stable public URL. The nested api/.htaccess
# routes API requests to api/index.php and protects its local config.
RewriteRule ^api(/|$) - [L,NC]

# Keep automated SSL certificate validation available to the hosting layer.
RewriteRule ^\.well-known/acme-challenge/ - [L,NC]

# Move the existing public URLs to explicit Arabic URLs while preserving their
# accumulated search value and query strings.
RewriteRule ^services/?$ /ar/services/ [R=301,L,NE]
RewriteRule ^services/(.+?)/?$ /ar/services/$1/ [R=301,L,NE]
RewriteRule ^(about|portfolio|studios|contact)/?$ /ar/$1/ [R=301,L,NE]

# Public localized pages use one canonical trailing-slash form. Asset requests
# keep their filenames unchanged.
RewriteCond %{REQUEST_URI} ^/(?:ar|en)(?:/.*)?$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
RewriteRule ^(.+)$ /$1/ [R=301,L,NE]

# Hostinger Git deployment checks out the repository at the web root.
# Deny source, migrations, tests, internal docs, and workflow files.
RewriteRule ^(?:src|database|tests|docs|scripts|scratch|artifacts|\.git|\.github|\.builds|node_modules|public)(?:/|$) - [F,L,NC]

<FilesMatch "^(?:\.env(?:\..*)?|package(?:-lock)?\.json|vite\.config\.(?:js|mjs|ts)|README(?:\..*)?|AGENTS\.md)$">
  Require all denied
</FilesMatch>

# Allow the committed production bundle to serve its own files.
RewriteRule ^dist/ - [L,NC]

# Map public asset requests to the Vite production bundle.
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
RewriteRule ^(.+)$ dist/$1 [L]

# A Git checkout can contain legacy databases, helper scripts, and other
# repository-root files. If a request did not match the production bundle,
# never serve an existing raw file or directory from public_html.
RewriteCond %{DOCUMENT_ROOT}/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/$1 -d
RewriteRule ^(.+)$ - [F,L]

# The root is the crawlable Arabic default. Private application routes keep an
# empty SPA shell so public prerendered content never flashes inside the ERP.
RewriteRule ^$ dist/index.html [L]
RewriteRule ^(?:login|change-password|reset-password|dashboard|erp|adminmt)(?:/|$) dist/app.html [L,NC]

# Unknown public routes are real 404 responses instead of SPA soft-404 pages.
ErrorDocument 404 /dist/404.html
RewriteRule ^ - [R=404,L]
